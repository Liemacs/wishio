# Producție — șablonul pentru .env-ul de pe server (docs/25).
# Se completează în panoul Forge sau Ploi și nu se comite. Valorile goale sunt
# obligatorii înainte de lansare, dacă nu scrie altfel lângă ele.

APP_NAME=Wishio
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://wishio.md
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Loguri zilnice, păstrate 14 zile, fără nivelul de depanare (docs/21, M-14).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Baza de date creată de panou. Colația e aceeași ca în dezvoltare și în CI:
# „Ștefan” = „stefan”, de care depinde potrivirea onomasticilor.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wishio
DB_USERNAME=
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

# Sesiunile paginilor publice: criptate și trimise doar prin HTTPS (docs/21, M-14).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Cozile și cache-ul pe Redis, instalat de panou. Worker-ul e un daemon în panou (docs/25 § 4).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Rezumatul săptămânal: un furnizor SMTP cu servere în UE și DPA (docs/20 § 2).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="salut@wishio.md"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME=Wishio

# --- Wishio ---------------------------------------------------------------
WISHIO_DEFAULT_COUNTRY=MD
WISHIO_DEFAULT_CURRENCY=MDL
WISHIO_SUPPORTED_LOCALES=ro,ru,en

# Notificări push reale, prin Expo. Cu `null` nu pleacă nimic.
WISHIO_PUSH_DRIVER=expo

# Operatorul și contactul din politică și din paginile de ajutor (docs/08, A7).
WISHIO_OPERATOR_NAME=
WISHIO_OPERATOR_ADDRESS=
WISHIO_PRIVACY_EMAIL=

# Contul demo pentru App Review: php artisan wishio:demo --force (docs/23 § 5).
WISHIO_DEMO_PASSWORD=

# Versiunea minimă a aplicației și linkurile spre magazine (docs/10 § 5).
WISHIO_MIN_APP_VERSION=0.1.0
WISHIO_APP_STORE_URL=
WISHIO_PLAY_STORE_URL=

# Pagina principală prezintă aplicația; butoanele apar când linkurile de mai sus sunt setate.
WISHIO_LANDING=app

# Linkurile wishio.md/@slug care deschid aplicația (docs/24 § 1).
WISHIO_IOS_APP_ID=
WISHIO_ANDROID_PACKAGE=md.wishio.app
WISHIO_ANDROID_SHA256=

# Catalogul manual, până la integrarea Magaziner (D-016).
WISHIO_CATALOG_ADAPTER=manual

# Niciun furnizor de AI activ: activarea cere condițiile din docs/21, M-15.
WISHIO_AI_PROVIDER=null
WISHIO_AI_MODEL=
WISHIO_AI_API_KEY=
WISHIO_AI_MAX_COST_PER_RUN=0.02
WISHIO_AI_MAX_COST_PER_DAY=5.00

# Nefolosit la MVP: nu colectăm numere de telefon (D-017).
WISHIO_CONTACT_HASH_PEPPER=

# Analytics pe site: rămâne gol până la condițiile din docs/21, M-16.
POSTHOG_KEY=

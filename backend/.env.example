APP_NAME=Wishio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wishio
DB_USERNAME=wishio
DB_PASSWORD=secret
# utf8mb4_unicode_ci: accent-insensitive (Ștefan = stefan), portabila MariaDB + MySQL 8.
# NU folosi utf8mb4_romanian_ci: trateaza diacriticele ca litere distincte si rupe name-day matching.
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# database in dezvoltare; redis + Horizon din sprintul S5 (cozi de notificari).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=Wishio

# --- Wishio ---------------------------------------------------------------
WISHIO_DEFAULT_COUNTRY=MD
WISHIO_DEFAULT_CURRENCY=MDL
WISHIO_SUPPORTED_LOCALES=ro,ru,en

# Pepper pentru HMAC-ul numerelor de telefon. NU se comite. NU se rotește fara
# procedura documentata in docs/06-privacy-legal.md (rotatia invalideaza hash-urile).
WISHIO_CONTACT_HASH_PEPPER=

# AI
WISHIO_AI_PROVIDER=null
WISHIO_AI_MODEL=
WISHIO_AI_API_KEY=
WISHIO_AI_MAX_COST_PER_RUN=0.02

# Catalog
WISHIO_CATALOG_ADAPTER=manual
WISHIO_DEMO_PASSWORD=
WISHIO_OPERATOR_ADDRESS=
WISHIO_MIN_APP_VERSION=0.1.0
WISHIO_APP_STORE_URL=
WISHIO_PLAY_STORE_URL=
# app: pagina principală prezintă aplicația; concierge: landing-ul din Faza 0 (docs/17)
WISHIO_LANDING=app

# Analytics / erori
POSTHOG_KEY=
SENTRY_LARAVEL_DSN=

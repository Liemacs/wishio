{
  "expo": {
    "name": "Wishio",
    "slug": "wishio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wishio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "md.wishio.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSContactsUsageDescription": "Wishio citește doar numele și, dacă există, ziua de naștere, ca să-ți amintească de ocaziile importante. Pe server ajung doar contactele pe care le alegi. Nu citim numere de telefon, emailuri sau poze."
      },
      "associatedDomains": [
        "applinks:wishio.md"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "md.wishio.app",
      "adaptiveIcon": {
        "backgroundColor": "#e11d48",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wishio.md",
              "pathPrefix": "/@"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "locales": {
      "ro": "./src/i18n/ios/ro.json",
      "ru": "./src/i18n/ios/ru.json",
      "en": "./src/i18n/ios/en.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Wishio citește doar numele și, dacă există, ziua de naștere, ca să-ți amintească de ocaziile importante. Pe server ajung doar contactele pe care le alegi. Nu citim numere de telefon, emailuri sau poze."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#e11d48",
          "defaultChannel": "occasions"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5c7f667-cbc5-4ecb-99e8-5c1b6a3a6a24"
      }
    },
    "owner": "liemax"
  }
}
